{
  "name": "UniLink Video Extension",
  "short_name": "UniLink_video",
  "version": "0.6.4.0",
  "manifest_version": 3,
  "description": "Speed up, slow down, advance and rewind the video lessons with shortcuts",
  "homepage_url": "https://github.com/Sammyilcoder/UniLink-video-extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "unilink-video-extension@sammyilcoder.github.io"
    }
  },
  "icons": {
    "16": "icons/logo.ico",
    "48": "icons/logo.ico",
    "128": "icons/logo.ico"
  },
  "permissions": ["storage"],
  "action": {
    "default_icon": {
      "16": "icons/logo.ico",
      "19": "icons/logo.ico",
      "38": "icons/logo.ico",
      "48": "icons/logo.ico"
    },
    "default_popup": "popup.html",
    "default_title": "UniLink Video Extension"
  },
  "content_scripts": [
    {
      "matches": [
        "https://smartlearn.unilink.it/mod/kalvidres/view.php*",
        "https://kmc.l2l.cineca.it/*",
        "https://*.smartlearn.unilink.it/*"
      ],
      "all_frames": true,
      "css": ["inject.css"],
      "js": ["inject.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.css"],
      "matches": [
        "https://smartlearn.unilink.it/*",
        "https://kmc.l2l.cineca.it/*",
        "https://*.smartlearn.unilink.it/*"
      ]
    }
  ]
}
